{
  "name": "ArchiveWebShelf",
  "description": "Record websites or import existing archives directly into ArchiveWebShelf",
  "version": "$VERSION",
  "permissions": [
    "debugger",
    "contextMenus",
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "webRequest"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {
    "16": "archive-shelf-icon-16.png",
    "32": "archive-shelf-icon-32.png",
    "48": "archive-shelf-icon-48.png",
    "128": "archive-shelf-icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "archive-shelf-icon-16.png",
      "32": "archive-shelf-icon-32.png",
      "48": "archive-shelf-icon-48.png"
    },
    "default_title": "ArchiveWebShelf",
    "default_popup": "shelf-popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["pdf/*", "ruffle/*"],
      "matches": ["*://*/*"]
    }
  ],
  "host_permissions": ["*://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "manifest_version": 3
}
